{
    "name": "elgentos/m2-vatfallback-graph-ql",
    "description": "Provides graph ql endpoint to dutchento/m2-vatfallback",
    "license": "MIT",
    "type": "magento2-module",
    "authors": [
        {
            "name": "Sander Jongsma",
            "email": "sander@elgentos.nl"
        }
    ],
    "require": {
        "dutchento/m2-vatfallback": "*"
    },
    "autoload": {
        "psr-4": {
            "Elgentos\\VatfallbackGraphQl\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
